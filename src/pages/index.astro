---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DEMO_FORM_ENDPOINT } from "@/config/demoForm";

const faqs = [
  {
    question: "What Does Improved365 Do?",
    answer: "We help organizations implement, customize, integrate, and optimize Microsoft Dynamics 365 Finance & Operations so the platform works better for the business. We are upgrade experts from Dynamics AX 2012 to Dynamics 365 Finance & Operations, with 20+ years across Dynamics AX 2012 and D365 F&O."
  },
  {
    question: "Which Microsoft Dynamics products do you support?",
    answer: "Microsoft Dynamics 365 Finance & Operations (implementation, configuration, customization, development, and support) and Dynamics AX 2012 upgrades to Dynamics 365 Finance & Operations — plus business process automation, system integration, data & reporting, and Azure/DevOps around that stack."
  },
  {
    question: "Can you upgrade us from Dynamics AX 2012 to Dynamics 365 Finance & Operations?",
    answer: "Yes. That is a core focus. We plan and deliver upgrades from Dynamics AX 2012 to Dynamics 365 Finance & Operations — inventorying customizations, migrating data, retiring technical debt, and landing on clean F&O configuration without unnecessary disruption."
  },
  {
    question: "Do you implement Dynamics 365 CRM / Customer Engagement?",
    answer: "No. Our practice is Dynamics 365 Finance & Operations and Dynamics AX 2012 upgrades to F&O — finance, supply chain, and related operations — not CRM."
  },
  {
    question: "Can you integrate Dynamics 365 Finance & Operations with our other systems?",
    answer: "Yes. We connect Dynamics 365 Finance & Operations with other applications, services, and business systems so data flows cleanly across the stack and manual handoffs disappear."
  },
  {
    question: "What does a typical engagement look like?",
    answer: "Whether you are implementing Dynamics 365 Finance & Operations, upgrading from Dynamics AX 2012, integrating systems, or optimizing what you already run — we turn business requirements into reliable, scalable F&O solutions and leave you with a clear path to value."
  }
];

const stats = [
  { value: "20+", label: "Years across Dynamics AX 2012 and D365 Finance & Operations" },
  { value: "AX 2012", label: "Upgrade experts to Dynamics 365 Finance & Operations" },
  { value: "F&O", label: "Focused on Finance & Operations — not CRM" }
];

const problemStats = [
  { value: "68%", text: "Waste 11+ hours per week on manual reconciliation, spreadsheet fixes, and data workarounds." },
  { value: "96%", text: "Suffer strategic decision delays due to fragmented, inconsistent, or stale financial data." },
  { value: "80%", text: "Report legacy ERP systems actively restrict their operational agility and business growth." },
  { value: "91%", text: "Require four or more calendar days to finalize their monthly financial close." }
];

const expertise = [
  {
    title: "DYNAMICS 365 FINANCE & OPERATIONS",
    desc: "Implementation, configuration, customization, development, and support — so Finance & Supply Chain on Dynamics 365 Finance & Operations run the way your business actually works."
  },
  {
    title: "AX 2012 → D365 F&O UPGRADES",
    desc: "Upgrade experts from Dynamics AX 2012 to Dynamics 365 Finance & Operations — clear migration path, data move, and cutover without guessing."
  },
  {
    title: "BUSINESS PROCESS AUTOMATION",
    desc: "Design solutions on Dynamics 365 Finance & Operations that streamline workflows, cut repetitive manual work, and free teams for higher-value decisions."
  },
  {
    title: "SYSTEM INTEGRATION",
    desc: "Connect Dynamics 365 Finance & Operations with other applications, services, and business systems so data and processes move without friction."
  },
  {
    title: "DATA & REPORTING",
    desc: "SQL Server, SSRS, dashboards, and custom reporting that turn Dynamics 365 Finance & Operations data into information leaders can act on."
  },
  {
    title: "CLOUD & DEVOPS",
    desc: "Azure environments, deployment pipelines, monitoring, and ongoing development so your Dynamics 365 Finance & Operations platform stays reliable and scalable."
  }
];

const howWeHelp = [
  {
    title: "IMPLEMENT",
    desc: "Stand up Dynamics 365 Finance & Operations the right way — scoped to your finance and operations processes.",
    href: "/dynamics-365-implementation-partner/"
  },
  {
    title: "UPGRADE AX 2012",
    desc: "Upgrade from Dynamics AX 2012 to Dynamics 365 Finance & Operations — our specialty.",
    href: "/ax-2012-to-dynamics-365/"
  },
  {
    title: "CUSTOMIZE & INTEGRATE",
    desc: "Shape Dynamics 365 Finance & Operations and connect it to the rest of your stack without unmaintainable technical debt.",
    href: "/dynamics-365-consultant/"
  },
  {
    title: "OPTIMIZE & SUPPORT",
    desc: "Improve what you already run on Dynamics 365 Finance & Operations — performance, automation, reporting, and support.",
    href: "/erp-modernization/"
  }
];

const demoAgendaItems = [
  { title: "CURRENT STATE & GOALS", desc: "Map your finance and operations requirements, system landscape, and growth priorities — including whether you are on Dynamics AX 2012 today." },
  { title: "DYNAMICS 365 FINANCE & OPERATIONS WALKTHROUGH", desc: "See how Dynamics 365 Finance & Operations supports GL, AP/AR, inventory, supply chain, and multi-entity operations end to end." },
  { title: "AX 2012 UPGRADE PATH", desc: "If you run Dynamics AX 2012 — a clear upgrade path to Dynamics 365 Finance & Operations: customizations, data, cutover, and risk." },
  { title: "INTEGRATION & AUTOMATION", desc: "Identify where connections and workflow automation on Dynamics 365 Finance & Operations remove manual effort and data re-entry." },
  { title: "DATA, REPORTING & ANALYTICS", desc: "Turn Dynamics 365 Finance & Operations transactional data into dashboards and reports leaders use for close, cash, and operations." },
  { title: "CLOUD, DEVOPS & SUPPORT", desc: "Cover Azure environments, deployment pipelines, monitoring, and how ongoing support keeps Dynamics 365 Finance & Operations healthy." },
  { title: "SCOPE & TIMELINE", desc: "Leave with a practical scope outline, rough timeline, and recommended path to value on Dynamics 365 Finance & Operations." }
];

const migrationPaths = [
  {
    title: "AX 2012 → D365 FINANCE & OPERATIONS",
    desc: "Upgrade experts from Dynamics AX 2012 to Dynamics 365 Finance & Operations — eliminate on-prem infrastructure and land on modern cloud F&O.",
    href: "/ax-2012-to-dynamics-365/"
  },
  {
    title: "DYNAMICS 365 F&O IMPLEMENTATION",
    desc: "New Dynamics 365 Finance & Operations implementations scoped to how your finance and operations teams actually work.",
    href: "/dynamics-365-implementation-partner/"
  },
  {
    title: "F&O OPTIMIZATION",
    desc: "Already on Dynamics 365 Finance & Operations? Improve performance, integrations, reporting, and day-to-day support.",
    href: "/erp-modernization/"
  },
  {
    title: "INTEGRATION & AUTOMATION",
    desc: "Connect Dynamics 365 Finance & Operations to the rest of your stack and automate repetitive finance and operations work.",
    href: "/dynamics-365-consultant/"
  }
];

const moneyPages = [
  { href: "/ax-2012-to-dynamics-365/", label: "AX 2012 → D365 F&O Upgrade" },
  { href: "/dynamics-365-implementation-partner/", label: "D365 F&O Implementation" },
  { href: "/dynamics-365-consultant/", label: "D365 F&O Consulting" },
  { href: "/dynamics-365-implementation-cost/", label: "Implementation Cost" },
  { href: "/erp-modernization/", label: "ERP Modernization" }
];

const industries = [
  { title: "MANUFACTURING & PRODUCTION", desc: "Inventory posting, Bills of Materials, and real-time production cost visibility on Dynamics 365 Finance & Operations." },
  { title: "DISTRIBUTION & SUPPLY CHAIN", desc: "Inventory tracking, multi-location warehouses, and cash-flow visibility on Dynamics 365 Finance & Operations." },
  { title: "PROFESSIONAL & PROJECT SERVICES", desc: "Project accounting, billing, and profitability tracking on Dynamics 365 Finance & Operations." },
  { title: "FIELD SERVICE & OPERATIONS", desc: "Work orders, dispatching, and service-related finance flows tied into Dynamics 365 Finance & Operations." }
];
---

<BaseLayout
  title="Dynamics 365 Finance & Operations | AX 2012 Upgrade Experts | Improved365"
  description="Helping businesses get more from Microsoft Dynamics 365 Finance & Operations. Upgrade experts from Dynamics AX 2012 to D365 F&O. Implement, customize, integrate, optimize, and support."
  canonical="https://improved365.com/"
  type="home"
  faqs={faqs}
>
  <section id="home" class="bg-slate-950 text-white py-20 md:py-28 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-transparent to-slate-950 pointer-events-none"></div>
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 bg-blue-900/60 border border-blue-500/30 text-blue-300 text-xs font-bold px-3.5 py-1.5 rounded-full mb-6 uppercase tracking-wider">
            UPGRADE EXPERTS FROM DYNAMICS AX 2012 TO DYNAMICS 365 FINANCE & OPERATIONS
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
            HELPING BUSINESSES GET MORE FROM <span class="text-blue-500">DYNAMICS 365 FINANCE & OPERATIONS</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-4">
            We help organizations implement, customize, integrate, and optimize Microsoft Dynamics 365 Finance & Operations so their technology works better for the business.
          </p>
          <p class="text-base text-slate-400 leading-relaxed mb-8">
            With more than 20 years across Dynamics AX 2012 and Dynamics 365 Finance & Operations, our team combines deep technical expertise with practical business knowledge — improving processes, connecting systems, automating repetitive work, and building solutions that scale. Special focus: upgrading from Dynamics AX 2012 to Dynamics 365 Finance & Operations.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-800 pt-6">
            {stats.map((stat) => (
              <div class="p-3 bg-slate-900/80 rounded-xl border border-slate-800">
                <span class="block text-2xl font-extrabold text-blue-400">{stat.value}</span>
                <span class="text-xs text-slate-400 leading-snug block mt-1">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div id="demo-form" class="lg:col-span-5">
          <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl shadow-2xl relative">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-400 block mb-1">SOLUTIONS CONVERSATION</span>
            <h2 class="text-2xl font-extrabold text-white mb-2">SCHEDULE YOUR DEMO</h2>
            <p class="text-xs text-slate-400 mb-6 leading-relaxed">
              A walkthrough focused on Dynamics 365 Finance & Operations — implementation, Dynamics AX 2012 upgrade, integration, or getting more from what you already run.
            </p>

            <form id="demoLeadForm" class="space-y-4" novalidate>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="demo-first-name" class="block text-xs font-medium text-slate-300 mb-1">First name*</label>
                  <input id="demo-first-name" name="firstName" type="text" required autocomplete="given-name" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                </div>
                <div>
                  <label for="demo-last-name" class="block text-xs font-medium text-slate-300 mb-1">Last name*</label>
                  <input id="demo-last-name" name="lastName" type="text" required autocomplete="family-name" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                </div>
              </div>
              <div>
                <label for="demo-email" class="block text-xs font-medium text-slate-300 mb-1">Email*</label>
                <input id="demo-email" name="email" type="email" required autocomplete="email" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <div>
                <label for="demo-company" class="block text-xs font-medium text-slate-300 mb-1">Company name*</label>
                <input id="demo-company" name="company" type="text" required autocomplete="organization" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <div>
                <label for="demo-job-title" class="block text-xs font-medium text-slate-300 mb-1">Job title*</label>
                <input id="demo-job-title" name="jobTitle" type="text" required autocomplete="organization-title" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <p id="demoFormStatus" class="hidden text-sm leading-relaxed" role="status" aria-live="polite"></p>
              <button
                id="demoSubmitBtn"
                type="submit"
                class="w-full bg-[#f06a31] hover:bg-[#d55317] text-white font-extrabold text-sm py-3.5 px-6 rounded-xl shadow-lg transition-all tracking-wider uppercase disabled:opacity-60 disabled:cursor-not-allowed"
              >
                REQUEST DEMO NOW
              </button>
            </form>
            <script define:vars={{ DEMO_FORM_ENDPOINT }}>
              (function () {
                var form = document.getElementById('demoLeadForm');
                if (!form) return;
                var statusEl = document.getElementById('demoFormStatus');
                var btn = document.getElementById('demoSubmitBtn');
                var endpoint = DEMO_FORM_ENDPOINT || '';

                function setStatus(msg, kind) {
                  if (!statusEl) return;
                  statusEl.textContent = msg;
                  statusEl.classList.remove('hidden', 'text-red-400', 'text-emerald-400', 'text-slate-400');
                  statusEl.classList.add(kind === 'ok' ? 'text-emerald-400' : kind === 'err' ? 'text-red-400' : 'text-slate-400');
                }

                form.addEventListener('submit', function (event) {
                  event.preventDefault();
                  if (!form.reportValidity()) return;

                  if (!endpoint) {
                    setStatus('Demo requests are not connected yet. Email contact@improved365.com directly and we will set up a time.', 'err');
                    return;
                  }

                  var payload = {
                    firstName: form.firstName.value.trim(),
                    lastName: form.lastName.value.trim(),
                    email: form.email.value.trim(),
                    company: form.company.value.trim(),
                    jobTitle: form.jobTitle.value.trim(),
                    source: window.location.href
                  };

                  btn.disabled = true;
                  setStatus('Sending…', 'info');

                  fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload),
                    redirect: 'follow'
                  })
                    .then(function (res) {
                      if (!res.ok && res.type !== 'opaque') {
                        throw new Error('Request failed');
                      }
                      setStatus('Thank you. An Improved365 solutions architect will reach out shortly.', 'ok');
                      form.reset();
                    })
                    .catch(function () {
                      setStatus('Something went wrong. Email contact@improved365.com and we will follow up.', 'err');
                    })
                    .finally(function () {
                      btn.disabled = false;
                    });
                });
              })();
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="how-we-help" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">WHAT WE DO</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
          IMPLEMENT. UPGRADE. CUSTOMIZE. OPTIMIZE.
        </h2>
        <p class="text-slate-600 leading-relaxed text-base">
          Whether you are implementing Dynamics 365 Finance & Operations, upgrading from Dynamics AX 2012, integrating systems, or getting more from your current F&O environment — we turn business requirements into reliable, scalable solutions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {howWeHelp.map((item) => (
          <a href={item.href} class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-md transition-all block">
            <h3 class="text-sm font-bold text-blue-600 mb-2 uppercase tracking-wide">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        {moneyPages.map((p) => (
          <a href={p.href} class="text-sm font-semibold text-blue-700 bg-blue-50 border border-blue-100 px-4 py-2 rounded-lg hover:bg-blue-100">{p.label}</a>
        ))}
      </div>
    </div>
  </section>

  <section id="expertise" class="py-20 bg-slate-50 border-b border-gray-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">OUR EXPERTISE</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          DYNAMICS 365 FINANCE & OPERATIONS + AX 2012
        </h2>
        <p class="text-slate-600 text-base mt-4">
          Technical depth where it matters — Dynamics 365 Finance & Operations, Dynamics AX 2012 upgrades, integration, data, and cloud operations. Not CRM.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {expertise.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wide text-blue-600">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="the-problem" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">THE CHALLENGE</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
          WHEN FINANCE & OPERATIONS SYSTEMS HOLD THE BUSINESS BACK.
        </h2>
        <p class="text-slate-600 leading-relaxed text-base mb-4">
          Most work starts with a real bottleneck: slow month-end close, systems that do not talk to each other, manual spreadsheets holding the process together, or Dynamics AX 2012 past its useful life.
        </p>
        <p class="text-slate-600 leading-relaxed text-base">
          Improved365 benchmark research shows enterprise teams lose strategic velocity when constrained by disconnected systems and unfinished Dynamics 365 Finance & Operations deployments.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {problemStats.map((item) => (
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
            <span class="text-4xl font-extrabold text-blue-600 mb-4 block">{item.value}</span>
            <p class="text-slate-700 text-sm leading-relaxed">{item.text}</p>
            <span class="text-[10px] uppercase tracking-wider text-slate-400 mt-4 block font-semibold">Improved365 ERP Research, 2026</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="demo-agenda" class="py-20 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-400 font-bold text-xs tracking-widest uppercase block mb-2">DEMO AGENDA</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white">
          WHAT YOUR DEMO SESSION INCLUDES
        </h2>
        <p class="text-slate-400 text-base mt-4">
          A practical session led by an Improved365 solutions architect — focused on Dynamics 365 Finance & Operations and Dynamics AX 2012 upgrades.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {demoAgendaItems.map((item, idx) => (
          <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 hover:border-blue-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-blue-400 bg-blue-950 px-2.5 py-1 rounded-md mb-4 inline-block">0{idx + 1}</span>
              <h3 class="text-sm font-bold text-white mb-2 uppercase tracking-wide">{item.title}</h3>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="migration-paths" class="py-20 bg-slate-50 border-b border-gray-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">UPGRADE & IMPLEMENTATION</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          DYNAMICS AX 2012 TO D365 FINANCE & OPERATIONS EXPERTS
        </h2>
        <p class="text-slate-600 text-base mt-4">
          Clear paths from Dynamics AX 2012 to Dynamics 365 Finance & Operations — and full F&O implementation, optimization, and integration.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {migrationPaths.map((path) => (
          <a href={path.href} class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-blue-300 hover:shadow-md transition-all">
            <div>
              <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wide text-blue-600">{path.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">{path.desc}</p>
              <span class="text-xs font-bold text-blue-600">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="results" class="py-20 bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto text-center mb-10">
        <span class="text-blue-400 font-bold text-xs tracking-widest uppercase block mb-2">HOW WE WORK</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-6">
          DYNAMICS 365 FINANCE & OPERATIONS THAT WORKS FOR THE BUSINESS
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          Deep Dynamics AX 2012 and Dynamics 365 Finance & Operations expertise — practical scope, clean configuration over unnecessary customization, and a path to value you can measure.
        </p>
      </div>
      <div class="flex justify-center">
        <a href="/ax-2012-to-dynamics-365/" class="inline-flex items-center bg-[#f06a31] hover:bg-[#d55317] text-white font-bold text-sm px-8 py-4 rounded-xl shadow-lg transition-all uppercase tracking-wider">
          AX 2012 → D365 F&O Upgrade Experts
        </a>
      </div>
    </div>
  </section>

  <section id="industries" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">INDUSTRIES</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          BUILT FOR COMPLEX OPERATIONAL BUSINESSES
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {industries.map((ind) => (
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200">
            <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wider text-blue-600">{ind.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{ind.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="py-20 bg-slate-50">
    <div class="max-w-screen-lg mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">KNOWLEDGE BASE</span>
        <h2 class="text-3xl font-extrabold text-slate-900">
          FREQUENTLY ASKED QUESTIONS
        </h2>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

