---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { DEMO_FORM_ENDPOINT } from "@/config/demoForm";

const faqs = [
  {
    question: "What Does Improved365 Do?",
    answer: "We help organizations implement, customize, integrate, and optimize Microsoft Dynamics 365 so their technology works better for the business. With 20+ years across Dynamics AX and Dynamics 365, we combine deep technical expertise with practical business knowledge."
  },
  {
    question: "Which Dynamics 365 Workloads Do You Support?",
    answer: "Dynamics 365 Finance & Operations (implementation, configuration, customization, development, and support) and Dynamics 365 Customer Engagement/CRM (development, customization, and integration), plus business process automation, system integration, data & reporting, and Azure/DevOps."
  },
  {
    question: "How Fast Can We Complete ERP Modernization?",
    answer: "With Improved365 Accelerated Delivery, deployment is up to 50% faster than standard Dynamics 365 implementations, with core financial modules live in as few as 6 months."
  },
  {
    question: "We Run Legacy Dynamics AX or GP. Do We Have to Upgrade?",
    answer: "Dynamics AX 2009, AX 2012, and GP are on countdown clocks with infrastructure past end-of-life. Upgrading to Dynamics 365 with Improved365 eliminates hardware maintenance, reduces custom technical debt, and unlocks modern cloud and AI capabilities."
  },
  {
    question: "How Does Improved365 Reduce Implementation Risk?",
    answer: "Improved365 uses 40+ pre-configured financial workflows, automated data migration tools, and industry best practices refined across hundreds of enterprise deployments, achieving a 95% project success rate."
  },
  {
    question: "Can You Integrate Dynamics 365 With Our Other Systems?",
    answer: "Yes. We connect Dynamics 365 with other applications, services, and business systems so data flows cleanly across the stack — reducing manual work and creating a single operational picture."
  }
];

const stats = [
  { value: "20+", label: "Years across Dynamics AX and Dynamics 365" },
  { value: "95%", label: "Project success rate across enterprise deployments" },
  { value: "30x", label: "Microsoft Inner Circle Elite Partner" }
];

const problemStats = [
  { value: "68%", text: "Waste 11+ hours per week on manual reconciliation, spreadsheet fixes, and data workarounds." },
  { value: "96%", text: "Suffer strategic decision delays due to fragmented, inconsistent, or stale financial data." },
  { value: "80%", text: "Report legacy ERP systems actively restrict their operational agility and business growth." },
  { value: "91%", text: "Require four or more calendar days to finalize their monthly financial close." }
];

const trustedBrands = [
  "IRRIMAX", "SAUNDERS BROTHERS", "KIDDER MATTHEWS", "RUDOLPHE LIBBE", "FINDLAY VINYL", "CABINET DISCOUNTERS"
];

const expertise = [
  {
    title: "DYNAMICS 365 FINANCE & OPERATIONS",
    desc: "Implementation, configuration, customization, development, and support — so Finance & Supply Chain run the way your business actually works."
  },
  {
    title: "DYNAMICS 365 CUSTOMER ENGAGEMENT / CRM",
    desc: "Development, customization, and integration for sales, service, and customer operations on Dynamics 365 CE."
  },
  {
    title: "BUSINESS PROCESS AUTOMATION",
    desc: "Design solutions that streamline workflows, cut repetitive manual work, and free teams for higher-value decisions."
  },
  {
    title: "SYSTEM INTEGRATION",
    desc: "Connect Dynamics 365 with other applications, services, and business systems so data and processes move without friction."
  },
  {
    title: "DATA & REPORTING",
    desc: "SQL Server, SSRS, dashboards, and custom reporting that turn operational data into information leaders can act on."
  },
  {
    title: "CLOUD & DEVOPS",
    desc: "Azure environments, deployment pipelines, monitoring, and ongoing development so your platform stays reliable and scalable."
  }
];

const howWeHelp = [
  {
    title: "IMPLEMENT",
    desc: "Stand up Dynamics 365 the right way — scoped to your processes, with proven templates that shorten time-to-value.",
    href: "/dynamics-365-implementation-partner/"
  },
  {
    title: "CUSTOMIZE",
    desc: "Shape Finance & Operations and Customer Engagement to fit how your teams work — without building unmaintainable technical debt.",
    href: "/dynamics-365-consultant/"
  },
  {
    title: "INTEGRATE",
    desc: "Connect Dynamics 365 to the rest of your stack so systems share data cleanly and manual handoffs disappear.",
    href: "/microsoft-dynamics-365-partner/"
  },
  {
    title: "OPTIMIZE & SUPPORT",
    desc: "Improve what you already run — performance, automation, reporting, and day-to-day support as the business grows.",
    href: "/erp-modernization/"
  }
];

const demoAgendaItems = [
  { title: "CURRENT STATE & GOALS", desc: "Map your business requirements, system landscape, and growth priorities so the session is specific to your organization." },
  { title: "FINANCE & OPERATIONS WALKTHROUGH", desc: "See how Dynamics 365 Finance & Operations supports GL, AP/AR, inventory, and multi-entity operations end to end." },
  { title: "CUSTOMER ENGAGEMENT OPTIONS", desc: "Review CRM capabilities for sales, service, and customer operations — and how they connect to finance and operations." },
  { title: "INTEGRATION & AUTOMATION", desc: "Identify where system connections and workflow automation remove manual effort and data re-entry." },
  { title: "DATA, REPORTING & ANALYTICS", desc: "Turn transactional data into dashboards and reports leaders use for close, cash, and operational decisions." },
  { title: "CLOUD, DEVOPS & SUPPORT MODEL", desc: "Cover Azure environments, deployment pipelines, monitoring, and how ongoing support keeps the platform healthy." },
  { title: "MIGRATION PATH (IF APPLICABLE)", desc: "For AX, GP, or other legacy systems — a clear path to Dynamics 365 without unnecessary disruption." },
  { title: "NEXT STEPS & TIMELINE", desc: "Leave with a practical scope outline, rough timeline, and recommended path to value." }
];

const migrationPaths = [
  { title: "AX 2009 TO D365 FINANCE", desc: "Transition legacy, customized AX 2009 systems into a streamlined, cloud Dynamics 365 platform without business disruption.", href: "/ax-2012-to-dynamics-365/" },
  { title: "AX 2012 CLOUD TRANSITION", desc: "Eliminate costly on-premises server infrastructure and modernize AX 2012 to Dynamics 365 Cloud Finance & Supply Chain.", href: "/ax-2012-to-dynamics-365/" },
  { title: "DYNAMICS GP TO ENTERPRISE D365", desc: "Scale beyond GP limits when entity growth, transaction volume, or reporting complexity require enterprise-grade Dynamics 365.", href: "/dynamics-gp-to-dynamics-365/" },
  { title: "LEGACY ON-PREM TO CLOUD ERP", desc: "Remove hardware overhead, VPN dependencies, and version lock with modern cloud Dynamics 365 architecture.", href: "/erp-modernization/" }
];

const moneyPages = [
  { href: "/dynamics-365-implementation-partner/", label: "Implementation Partner" },
  { href: "/microsoft-dynamics-365-partner/", label: "Dynamics 365 Partner" },
  { href: "/dynamics-365-consultant/", label: "Dynamics 365 Consultant" },
  { href: "/dynamics-365-implementation-cost/", label: "Implementation Cost" },
  { href: "/erp-modernization/", label: "ERP Modernization" },
  { href: "/ax-2012-to-dynamics-365/", label: "AX 2012 → D365" },
  { href: "/dynamics-gp-to-dynamics-365/", label: "GP → D365" }
];

const industries = [
  { title: "MANUFACTURING & PRODUCTION", desc: "Accelerate inventory posting, simplify complex Bills of Materials, and gain real-time production cost visibility." },
  { title: "DISTRIBUTION & SUPPLY CHAIN", desc: "Eliminate cash flow bottlenecks, automate inventory tracking, and synchronize multi-location warehouse operations." },
  { title: "PROFESSIONAL & PROJECT SERVICES", desc: "Unify project accounting, billing, contractor management, and real-time profitability tracking." },
  { title: "FIELD SERVICE & OPERATIONS", desc: "Streamline high-volume work orders, field dispatching, and mobile service invoicing." }
];

const resultsStats = [
  { value: "67%", label: "Lower implementation cost vs traditional consultants" },
  { value: "50%", label: "Faster time-to-value on deployment" },
  { value: "95%", label: "Proven project success rate" },
  { value: "30%+", label: "Reduction in long-term Total Cost of Ownership" }
];
---

<BaseLayout
  title="Microsoft Dynamics 365 Partner | Implement, Customize, Integrate | Improved365"
  description="Helping businesses get more from Microsoft Dynamics 365. 20+ years across Dynamics AX and Dynamics 365. Implement, customize, integrate, optimize, and support Finance & Operations and Customer Engagement."
  canonical="https://improved365.com/"
  type="home"
  faqs={faqs}
>
  <!-- Hero Section -->
  <section id="home" class="bg-slate-950 text-white py-20 md:py-28 border-b border-slate-800 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-blue-900/20 via-transparent to-slate-950 pointer-events-none"></div>
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 bg-blue-900/60 border border-blue-500/30 text-blue-300 text-xs font-bold px-3.5 py-1.5 rounded-full mb-6 uppercase tracking-wider">
            MICROSOFT US PARTNER OF THE YEAR — 30x MICROSOFT INNER CIRCLE
          </div>
          <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
            HELPING BUSINESSES GET MORE FROM <span class="text-blue-500">MICROSOFT DYNAMICS 365</span>
          </h1>
          <p class="text-lg md:text-xl text-slate-300 leading-relaxed mb-4">
            We help organizations implement, customize, integrate, and optimize Microsoft Dynamics 365 so their technology works better for the business.
          </p>
          <p class="text-base text-slate-400 leading-relaxed mb-8">
            With more than 20 years across Microsoft Dynamics AX and Dynamics 365, our team combines deep technical expertise with practical business knowledge — improving processes, connecting systems, automating repetitive work, and building solutions that scale as you grow.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 border-t border-slate-800 pt-6">
            {stats.map((stat) => (
              <div class="p-3 bg-slate-900/80 rounded-xl border border-slate-800">
                <span class="block text-2xl font-extrabold text-blue-400">{stat.value}</span>
                <span class="text-xs text-slate-400 leading-snug block mt-1">{stat.label}</span>
              </div>
            ))}
          </div>
        </div>

        <div id="demo-form" class="lg:col-span-5">
          <div class="bg-slate-900 border border-slate-800 p-8 rounded-2xl shadow-2xl relative">
            <span class="text-xs font-bold uppercase tracking-widest text-blue-400 block mb-1">SOLUTIONS CONVERSATION</span>
            <h2 class="text-2xl font-extrabold text-white mb-2">SCHEDULE YOUR DEMO</h2>
            <p class="text-xs text-slate-400 mb-6 leading-relaxed">
              A walkthrough focused on your Dynamics 365 goals — implementation, upgrade, integration, or getting more from what you already run.
            </p>

            <form id="demoLeadForm" class="space-y-4" novalidate>
              <div class="grid grid-cols-2 gap-4">
                <div>
                  <label for="demo-first-name" class="block text-xs font-medium text-slate-300 mb-1">First name*</label>
                  <input id="demo-first-name" name="firstName" type="text" required autocomplete="given-name" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                </div>
                <div>
                  <label for="demo-last-name" class="block text-xs font-medium text-slate-300 mb-1">Last name*</label>
                  <input id="demo-last-name" name="lastName" type="text" required autocomplete="family-name" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
                </div>
              </div>
              <div>
                <label for="demo-email" class="block text-xs font-medium text-slate-300 mb-1">Email*</label>
                <input id="demo-email" name="email" type="email" required autocomplete="email" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <div>
                <label for="demo-company" class="block text-xs font-medium text-slate-300 mb-1">Company name*</label>
                <input id="demo-company" name="company" type="text" required autocomplete="organization" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <div>
                <label for="demo-job-title" class="block text-xs font-medium text-slate-300 mb-1">Job title*</label>
                <input id="demo-job-title" name="jobTitle" type="text" required autocomplete="organization-title" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-blue-500" />
              </div>
              <p id="demoFormStatus" class="hidden text-sm leading-relaxed" role="status" aria-live="polite"></p>
              <button
                id="demoSubmitBtn"
                type="submit"
                class="w-full bg-[#f06a31] hover:bg-[#d55317] text-white font-extrabold text-sm py-3.5 px-6 rounded-xl shadow-lg transition-all tracking-wider uppercase disabled:opacity-60 disabled:cursor-not-allowed"
              >
                REQUEST DEMO NOW
              </button>
            </form>
            <script define:vars={{ DEMO_FORM_ENDPOINT }}>
              (function () {
                var form = document.getElementById('demoLeadForm');
                if (!form) return;
                var statusEl = document.getElementById('demoFormStatus');
                var btn = document.getElementById('demoSubmitBtn');
                var endpoint = DEMO_FORM_ENDPOINT || '';

                function setStatus(msg, kind) {
                  if (!statusEl) return;
                  statusEl.textContent = msg;
                  statusEl.classList.remove('hidden', 'text-red-400', 'text-emerald-400', 'text-slate-400');
                  statusEl.classList.add(kind === 'ok' ? 'text-emerald-400' : kind === 'err' ? 'text-red-400' : 'text-slate-400');
                }

                form.addEventListener('submit', function (event) {
                  event.preventDefault();
                  if (!form.reportValidity()) return;

                  if (!endpoint) {
                    setStatus('Demo requests are not connected yet. Email contact@improved365.com directly and we will set up a time.', 'err');
                    return;
                  }

                  var payload = {
                    firstName: form.firstName.value.trim(),
                    lastName: form.lastName.value.trim(),
                    email: form.email.value.trim(),
                    company: form.company.value.trim(),
                    jobTitle: form.jobTitle.value.trim(),
                    source: window.location.href
                  };

                  btn.disabled = true;
                  setStatus('Sending…', 'info');

                  fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                    body: JSON.stringify(payload),
                    redirect: 'follow'
                  })
                    .then(function (res) {
                      if (!res.ok && res.type !== 'opaque') {
                        throw new Error('Request failed');
                      }
                      setStatus('Thank you. An Improved365 solutions architect will reach out shortly.', 'ok');
                      form.reset();
                    })
                    .catch(function () {
                      setStatus('Something went wrong. Email contact@improved365.com and we will follow up.', 'err');
                    })
                    .finally(function () {
                      btn.disabled = false;
                    });
                });
              })();
            </script>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Trusted Logos -->
  <section class="py-10 bg-slate-900 border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 text-center">
      <p class="text-xs font-bold text-slate-400 tracking-widest uppercase mb-6">TRUSTED BY MID-MARKET AND ENTERPRISE INDUSTRY LEADERS</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 opacity-75">
        {trustedBrands.map((brand) => (
          <span class="text-slate-300 font-extrabold text-sm tracking-wider uppercase bg-slate-800/50 px-4 py-2 rounded-md border border-slate-700/50">{brand}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- How We Help -->
  <section id="how-we-help" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">WHAT WE DO</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
          IMPLEMENT. CUSTOMIZE. INTEGRATE. OPTIMIZE.
        </h2>
        <p class="text-slate-600 leading-relaxed text-base">
          Whether you are implementing Dynamics 365, upgrading an existing environment, integrating multiple systems, or looking to get more value from your current platform — we turn business requirements into reliable, scalable solutions.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {howWeHelp.map((item) => (
          <a href={item.href} class="p-6 bg-slate-50 rounded-2xl border border-slate-200 hover:border-blue-300 hover:shadow-md transition-all block">
            <h3 class="text-sm font-bold text-blue-600 mb-2 uppercase tracking-wide">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </a>
        ))}
      </div>
      <div class="mt-10 flex flex-wrap gap-3">
        {moneyPages.map((p) => (
          <a href={p.href} class="text-sm font-semibold text-blue-700 bg-blue-50 border border-blue-100 px-4 py-2 rounded-lg hover:bg-blue-100">{p.label}</a>
        ))}
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section id="expertise" class="py-20 bg-slate-50 border-b border-gray-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">OUR EXPERTISE</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          FULL-STACK DYNAMICS 365 CAPABILITY
        </h2>
        <p class="text-slate-600 text-base mt-4">
          Technical depth across the Microsoft Dynamics stack — from finance and CRM to integration, data, and cloud operations.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {expertise.map((item) => (
          <div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wide text-blue-600">{item.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- The Problem -->
  <section id="the-problem" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">THE CHALLENGE</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-6">
          WHEN DYNAMICS 365 ISN'T WORKING HARD ENOUGH FOR THE BUSINESS.
        </h2>
        <p class="text-slate-600 leading-relaxed text-base mb-4">
          Most modernization work starts with a real bottleneck: slow month-end close, systems that do not talk to each other, manual spreadsheets holding the process together, or an aging AX/GP environment past its useful life.
        </p>
        <p class="text-slate-600 leading-relaxed text-base">
          Improved365 benchmark research shows enterprise teams lose strategic velocity when constrained by disconnected systems and unfinished Dynamics deployments.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {problemStats.map((item) => (
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200 flex flex-col justify-between">
            <span class="text-4xl font-extrabold text-blue-600 mb-4 block">{item.value}</span>
            <p class="text-slate-700 text-sm leading-relaxed">{item.text}</p>
            <span class="text-[10px] uppercase tracking-wider text-slate-400 mt-4 block font-semibold">Improved365 ERP Research, 2026</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Demo Agenda -->
  <section id="demo-agenda" class="py-20 bg-slate-900 text-white border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-400 font-bold text-xs tracking-widest uppercase block mb-2">DEMO AGENDA</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white">
          WHAT YOUR DEMO SESSION INCLUDES
        </h2>
        <p class="text-slate-400 text-base mt-4">
          A practical session led by an Improved365 solutions architect — tailored to your systems, processes, and goals.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {demoAgendaItems.map((item, idx) => (
          <div class="bg-slate-950 p-6 rounded-2xl border border-slate-800 hover:border-blue-500/50 transition-all flex flex-col justify-between">
            <div>
              <span class="text-xs font-bold text-blue-400 bg-blue-950 px-2.5 py-1 rounded-md mb-4 inline-block">0{idx + 1}</span>
              <h3 class="text-sm font-bold text-white mb-2 uppercase tracking-wide">{item.title}</h3>
              <p class="text-xs text-slate-400 leading-relaxed mb-4">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Migration Paths -->
  <section id="migration-paths" class="py-20 bg-slate-50 border-b border-gray-200">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">MIGRATION & MODERNIZATION</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          PROVEN TRANSITION PATHWAYS
        </h2>
        <p class="text-slate-600 text-base mt-4">
          Seamless cloud transitions from legacy Microsoft Dynamics platforms and on-prem ERP — built on 20+ years of AX and Dynamics 365 experience.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {migrationPaths.map((path) => (
          <a href={path.href} class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between hover:border-blue-300 hover:shadow-md transition-all">
            <div>
              <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wide text-blue-600">{path.title}</h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">{path.desc}</p>
              <span class="text-xs font-bold text-blue-600">Learn more →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Results -->
  <section id="results" class="py-20 bg-slate-950 text-white border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl mx-auto text-center mb-16">
        <span class="text-blue-400 font-bold text-xs tracking-widest uppercase block mb-2">PROVEN OUTCOMES</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-white mb-6">
          DYNAMICS 365 THAT WORKS BETTER FOR THE BUSINESS
        </h2>
        <p class="text-slate-300 text-base leading-relaxed">
          Pre-configured models, industry accelerators, and automated migration pipelines — so you skip months of repetitive discovery and reach value faster.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {resultsStats.map((stat) => (
          <div class="p-8 bg-slate-900 rounded-2xl border border-slate-800 text-center">
            <span class="block text-4xl font-extrabold text-blue-400 mb-2">{stat.value}</span>
            <p class="text-xs text-slate-300 font-semibold">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section id="industries" class="py-20 bg-white border-b border-gray-100">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">INDUSTRIES</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900">
          BUILT FOR COMPLEX OPERATIONAL BUSINESSES
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {industries.map((ind) => (
          <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200">
            <h3 class="text-sm font-bold text-slate-900 mb-2 uppercase tracking-wider text-blue-600">{ind.title}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{ind.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section id="faq" class="py-20 bg-slate-50">
    <div class="max-w-screen-lg mx-auto px-4 md:px-8">
      <div class="text-center mb-12">
        <span class="text-blue-600 font-bold text-xs tracking-widest uppercase block mb-2">KNOWLEDGE BASE</span>
        <h2 class="text-3xl font-extrabold text-slate-900">
          FREQUENTLY ASKED QUESTIONS
        </h2>
      </div>

      <div class="space-y-6">
        {faqs.map((faq) => (
          <div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
            <h3 class="text-base font-bold text-slate-900 mb-2">{faq.question}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-blue-600 text-white py-16">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-3xl md:text-4xl font-extrabold mb-4">
        READY TO GET MORE FROM DYNAMICS 365?
      </h2>
      <p class="text-blue-100 text-base max-w-2xl mx-auto mb-8 leading-relaxed">
        Talk with an Improved365 solutions architect about implementation, upgrade, integration, or optimization — and leave with a clear next step.
      </p>
      <a
        href="#demo-form"
        class="inline-flex items-center bg-slate-950 text-white hover:bg-slate-900 font-bold text-sm px-8 py-4 rounded-xl shadow-lg transition-all gap-2"
      >
        <span>SCHEDULE YOUR DEMO</span>
        <svg class="size-4 fill-current" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"/></svg>
      </a>
    </div>
  </section>
</BaseLayout>
