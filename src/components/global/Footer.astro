---
const footerLinks = [
  {
    title: "Services",
    links: [
      { href: "/dynamics-365-implementation-partner/", label: "Implementation Partner" },
      { href: "/microsoft-dynamics-365-partner/", label: "Dynamics 365 Partner" },
      { href: "/dynamics-365-consultant/", label: "Dynamics 365 Consultant" },
      { href: "/dynamics-365-implementation-cost/", label: "Implementation Cost" },
      { href: "/erp-modernization/", label: "ERP Modernization" },
    ],
  },
  {
    title: "Migration",
    links: [
      { href: "/ax-2012-to-dynamics-365/", label: "AX 2012 to D365" },
      { href: "/dynamics-gp-to-dynamics-365/", label: "GP to D365" },
      { href: "/#industries", label: "Industries" },
      { href: "/#results", label: "Results" },
    ],
  },
  {
    title: "Company & Contact",
    links: [
      { href: "mailto:contact@improved365.com", label: "contact@improved365.com", isEmail: true },
      { href: "/#demo-form", label: "Schedule Live Demo" },
      { href: "/#faq", label: "FAQ" },
      { href: "/", label: "Home" },
    ],
  },
];
---

<footer class="bg-slate-950 text-white mt-16 py-16 border-t border-slate-800">
  <div class="max-w-screen-xl mx-auto px-4 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
      <div>
        <div class="flex items-center gap-3 font-bold text-2xl tracking-tight text-white mb-4">
          <img src="/improved_365_logo.webp" alt="Improved365 Logo" class="h-10 w-auto object-contain" />
        </div>
        <p class="text-slate-400 text-sm leading-relaxed mb-6">
          Helping businesses get more from Microsoft Dynamics 365 — implement, customize, integrate, optimize, and support. 20+ years across Dynamics AX and Dynamics 365. Microsoft US Partner of the Year & 30x Inner Circle.
        </p>
        <a
          href="/#demo-form"
          class="inline-block bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold py-2.5 px-5 rounded-lg shadow-md transition-all uppercase tracking-wider"
        >
          Schedule Your Demo
        </a>
      </div>

      {footerLinks.map((col) => (
        <div>
          <h3 class="font-bold text-white mb-4 text-base tracking-wide uppercase text-xs text-blue-400">{col.title}</h3>
          <ul class="space-y-2.5 text-sm">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-slate-400 hover:text-blue-300 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-slate-800/80 pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-slate-500 gap-4">
      <p>© 2026 improved365.com — All Rights Reserved. Microsoft Dynamics 365 implementation, customization, integration & support.</p>
      <div class="flex gap-6">
        <a href="#" class="hover:text-slate-300">Privacy Policy</a>
        <a href="#" class="hover:text-slate-300">Terms of Service</a>
        <a href="mailto:contact@improved365.com" class="hover:text-slate-300">Contact Us</a>
      </div>
    </div>
  </div>
</footer>
