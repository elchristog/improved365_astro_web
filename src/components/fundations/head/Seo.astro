---
import { AstroSeo } from "@lexingtonthemes/seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title = "Microsoft Dynamics 365 Partner | Implement, Customize, Integrate | Improved365",
  description = "Helping businesses get more from Microsoft Dynamics 365. 20+ years across Dynamics AX and Dynamics 365. Implement, customize, integrate, optimize, and support.",
  canonical = "https://improved365.com/",
  ogImage = "https://improved365.com/improved_365_logo.webp",
  type = "website"
} = Astro.props;
---

<AstroSeo
  title={title}
  description={description}
  canonical={canonical}
  openGraph={{
    url: canonical,
    title: title,
    description: description,
    images: [
      {
        url: ogImage,
        width: 1200,
        height: 630,
        alt: title,
        type: "image/webp",
      },
    ],
    site_name: "Improved365",
    type,
    locale: "en_US",
  }}
  twitter={{
    cardType: "summary_large_image",
  }}
/>
