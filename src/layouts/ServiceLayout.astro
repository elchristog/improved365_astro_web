---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  canonical: string;
  h1: string;
  intro: string;
  badge?: string;
  bullets?: string[];
  sections?: Array<{ title: string; body: string }>;
  faqs?: Array<{ question: string; answer: string }>;
  related?: Array<{ href: string; label: string }>;
}

const {
  title,
  description,
  canonical,
  h1,
  intro,
  badge = "DYNAMICS 365 FINANCE & OPERATIONS",
  bullets = [],
  sections = [],
  faqs = [],
  related = []
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="service"
  faqs={faqs}
>
  <section class="bg-slate-950 text-white py-16 md:py-24 border-b border-slate-800">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8">
      <div class="max-w-3xl">
        <span class="inline-flex items-center gap-2 bg-blue-900/60 border border-blue-500/30 text-blue-300 text-xs font-bold px-3.5 py-1.5 rounded-full mb-6 uppercase tracking-wider">
          {badge}
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight leading-tight mb-6">
          {h1}
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed mb-8">{intro}</p>
        {bullets.length > 0 && (
          <ul class="space-y-3 mb-8">
            {bullets.map((b) => (
              <li class="flex gap-3 text-sm text-slate-200">
                <span class="text-blue-400 font-bold">✓</span>
                <span>{b}</span>
              </li>
            ))}
          </ul>
        )}
        <a
          href="/#demo-form"
          class="inline-flex items-center bg-[#f06a31] hover:bg-[#d55317] text-white font-extrabold text-sm py-3.5 px-7 rounded-xl shadow-lg transition-all tracking-wider uppercase"
        >
          Schedule Demo
        </a>
      </div>
    </div>
  </section>

  {sections.length > 0 && (
    <section class="py-16 bg-white border-b border-gray-100">
      <div class="max-w-screen-xl mx-auto px-4 md:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {sections.map((s) => (
            <div class="p-6 bg-slate-50 rounded-2xl border border-slate-200">
              <h2 class="text-lg font-extrabold text-slate-900 mb-3 tracking-tight">{s.title}</h2>
              <p class="text-sm text-slate-600 leading-relaxed">{s.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <slot />

  {faqs.length > 0 && (
    <section class="py-16 bg-slate-50 border-b border-gray-200">
      <div class="max-w-screen-lg mx-auto px-4 md:px-8">
        <h2 class="text-2xl font-extrabold text-slate-900 mb-8">Frequently Asked Questions</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <div class="p-6 bg-white rounded-2xl border border-slate-200">
              <h3 class="text-base font-bold text-slate-900 mb-2">{faq.question}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {related.length > 0 && (
    <section class="py-12 bg-white border-b border-gray-100">
      <div class="max-w-screen-xl mx-auto px-4 md:px-8">
        <h2 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-4">Related services</h2>
        <div class="flex flex-wrap gap-3">
          {related.map((r) => (
            <a href={r.href} class="text-sm font-semibold text-blue-600 hover:text-blue-800 bg-blue-50 border border-blue-100 px-4 py-2 rounded-lg">
              {r.label}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bg-blue-600 text-white py-14">
    <div class="max-w-screen-xl mx-auto px-4 md:px-8 text-center">
      <h2 class="text-2xl md:text-3xl font-extrabold mb-4">Ready to get more from Dynamics 365 Finance & Operations?</h2>
      <p class="text-blue-100 text-base max-w-2xl mx-auto mb-8">Talk with an Improved365 solutions architect about Finance & Operations implementation, a Dynamics AX 2012 upgrade, integration, or optimization.</p>
      <a href="/#demo-form" class="inline-flex items-center bg-slate-950 text-white hover:bg-slate-900 font-bold text-sm px-8 py-4 rounded-xl shadow-lg transition-all">
        Schedule Your Demo
      </a>
    </div>
  </section>
</BaseLayout>
